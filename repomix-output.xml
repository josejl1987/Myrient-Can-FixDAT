def _atomic_rebuild_task(torrent_dir: str, index_path: str) -> str:
    import os
    import sqlite3
    import tempfile

    target = Path(index_path)
    target.parent.mkdir(parents=True, exist_ok=True)
    fd, temp_name = tempfile.mkstemp(prefix=f".{target.name}.", suffix=".tmp", dir=target.parent)
    os.close(fd)
    temp = Path(temp_name)
    temp.unlink(missing_ok=True)
    try:
        build_index(Path(torrent_dir), temp)
        with sqlite3.connect(temp) as connection:
            result = connection.execute("PRAGMA quick_check").fetchone()
            if not result or result[0] != "ok":
                raise RuntimeError(f"Temporary index failed quick_check: {result}")
        os.replace(temp, target)
        return str(target)
    finally:
        temp.unlink(missing_ok=True)


def _integrity_task(index_path: str) -> dict:
    return MinervaDB(index_path).run_integrity_check()


def _missing_sources_task(index_path: str, torrent_dir: str) -> list[dict]:
    return MinervaDB(index_path).find_missing_torrent_sources(Path(torrent_dir))


class _SystemFilterProxy(QtCore.QSortFilterProxyModel):
    """Filter systems by search text and maintenance-oriented category."""

    def __init__(self, parent=None) -> None:
        super().__init__(parent)
        self.text = ""
        self.mode = "all"
        self.setSortRole(Qt.ItemDataRole.UserRole)
        self.setDynamicSortFilter(True)

    def set_text(self, text: str) -> None:
        self.text = text.casefold().strip()
        self.invalidateFilter()

    def set_mode(self, mode: str) -> None:
        self.mode = mode
        self.invalidateFilter()

    def filterAcceptsRow(self, source_row, source_parent):  # noqa: N802
        model = self.sourceModel()
        if model is None:
            return True
        item = model._records[source_row]  # noqa: SLF001
        if self.text and self.text not in item.system.casefold():
            return False
        if self.mode == "covered" and not (item.coverage is not None and item.coverage >= 1.0):
            return False
        if self.mode == "missing" and item.source_present:
            return False
        if self.mode == "unreferenced" and item.expected_files is not None:
            return False
        return True


class _SourceBadgeDelegate(QtWidgets.QStyledItemDelegate):
    def __init__(self, tokens: ThemeTokens = ThemeTokens(), parent=None) -> None:
        super().__init__(parent)
        self._tokens = tokens

    def paint(self, painter, option, index) -> None:
        style = option.widget.style() if option.widget else QtWidgets.QApplication.style()
        style.drawPrimitive(
            QtWidgets.QStyle.PrimitiveElement.PE_PanelItemViewItem, option, painter, option.widget
        )
        available = str(index.data(Qt.ItemDataRole.UserRole)).casefold() == "available"
        label = "Available" if available else "Missing"
        fg = self._tokens.success if available else self._tokens.error
        bg = "#153126" if available else "#351d25"
        painter.save()
        font = QtGui.QFont(option.font)
        font.setBold(True)
        font.setPointSize(max(8, option.font.pointSize() - 1))
        painter.setFont(font)
        width = min(option.rect.width() - 12, QtGui.QFontMetrics(font).horizontalAdvance(label) + 18)
        rect = QtCore.QRect(
            option.rect.center().x() - width // 2,
            option.rect.center().y() - 11,
            width,
            22,
        )
        painter.setPen(QtCore.Qt.PenStyle.NoPen)
        painter.setBrush(QtGui.QColor(bg))
        painter.drawRoundedRect(rect, 10, 10)
        painter.setPen(QtGui.QColor(fg))
        painter.drawText(rect, Qt.AlignmentFlag.AlignCenter, label)
        painter.restore()


class _CoverageDelegate(QtWidgets.QStyledItemDelegate):
    """Compact coverage bar with a readable percentage or unknown state."""

    def __init__(self, tokens: ThemeTokens = ThemeTokens(), parent=None) -> None:
        super().__init__(parent)
        self._tokens = tokens

    def paint(self, painter, option, index) -> None:
        style = option.widget.style() if option.widget else QtWidgets.QApplication.style()
        style.drawPrimitive(
            QtWidgets.QStyle.PrimitiveElement.PE_PanelItemViewItem, option, painter, option.widget
        )
        raw = index.data(Qt.ItemDataRole.UserRole)
        if not isinstance(raw, (int, float)) or raw < 0:
            painter.save()
            painter.setPen(QtGui.QColor(self._tokens.text_muted))
            painter.drawText(option.rect, Qt.AlignmentFlag.AlignCenter, "Unknown")
            painter.restore()
            return

        value = max(0.0, min(1.0, float(raw)))
        painter.save()
        text_rect = option.rect.adjusted(8, 2, -8, -16)
        painter.setPen(QtGui.QColor(self._tokens.text))
        painter.drawText(text_rect, Qt.AlignmentFlag.AlignCenter, f"{value:.1%}")
        track = QtCore.QRect(
            option.rect.left() + 12,
            option.rect.bottom() - 12,
            option.rect.width() - 24,
            4,
        )
        painter.setPen(QtCore.Qt.PenStyle.NoPen)
        painter.setBrush(QtGui.QColor(self._tokens.surface_raised))
        painter.drawRoundedRect(track, 2, 2)
        fill = QtCore.QRect(track.left(), track.top(), int(track.width() * value), track.height())
        painter.setBrush(
            QtGui.QColor(self._tokens.success if value >= 1.0 else self._tokens.accent)
        )
        painter.drawRoundedRect(fill, 2, 2)
        painter.restore()


