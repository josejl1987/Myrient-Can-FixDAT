_SYSTEM_TO_CDR_SLUG = {
    "Sony - PlayStation": "psx-iso",
    "Sony - PlayStation 2": "ps2-iso",
    "Sony - PlayStation Portable": "psp",
    "Sony - PlayStation Vita": "vita",
