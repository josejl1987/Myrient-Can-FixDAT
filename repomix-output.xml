QScrollBar:horizontal { background: transparent; height: 8px; border: none; }
QScrollBar::handle:horizontal { background: {{token.scrollbar}}; border-radius: 4px; min-width: 30px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; background: none; border: none; }

/* ── Progress, menus and tooltips ───────────────────────────────────────── */
QProgressBar {
    background: {{token.surface_raised}};
    border: none;
    border-radius: 3px;
    text-align: center;
    font-size: 10px;
    min-height: 6px;
    max-height: 6px;
}
