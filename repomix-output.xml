<file path="app/worker_manager.py">
"""
Generic thread-lifecycle manager for AppShell.

Manages the ``_filter_load_thread`` (``threading.Thread``) used during
library index loading.  Download lifecycle is owned exclusively by
``DownloadController``.
"""

from __future__ import annotations

import logging
import threading

from PyQt6 import QtCore

log = logging.getLogger(__name__)


class WorkerManager(QtCore.QObject):
    """Manages the filter-load thread lifecycle.

    Does **not** own download state — see ``DownloadController``.
    """

    def __init__(self, parent: QtCore.QObject | None = None) -> None:
        super().__init__(parent)
        self.filter_load_thread: threading.Thread | None = None

    def is_active(self) -> bool:
        """Return ``True`` if the filter-load thread is running."""
        return (
            self.filter_load_thread is not None
            and self.filter_load_thread.is_alive()
        )

    def prepare_shutdown(self, timeout_ms: int = 2500) -> bool:
        """Join the filter-load thread if running.

        Returns ``True`` if the thread stopped within *timeout_ms*,
        ``False`` otherwise.
        """
        if (
            self.filter_load_thread is not None
            and self.filter_load_thread.is_alive()
        ):
            self.filter_load_thread.join(timeout=timeout_ms / 1000)
        return not self.is_active()
