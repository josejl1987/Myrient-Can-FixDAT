log = logging.getLogger(__name__)


def _cdr_search_task(game_name: str, slug: str | None) -> list[dict]:
    """Background task — search Wordpress REST API (non-blocking)."""
    import json
    from urllib.parse import quote
    from urllib.request import Request, urlopen

    base = "https://retrogametalk.com/repo/wp-json/wp/v2/search"
    url = f"{base}?search={quote(game_name)}&per_page=8"
    req = Request(url, headers={"User-Agent": "MinervaFixDAT/1.0"})
    with urlopen(req, timeout=10) as resp:
        data: list[dict] = json.loads(resp.read().decode())
    if slug:
        filtered = [r for r in data if f"/{slug}/" in r.get("url", "")]
        if filtered:
            data = filtered
    return data


@dataclass(frozen=True)
class ReviewRow:
    entry: ReviewEntry
    best: LibraryItem | None = None

    @property
    def category(self) -> str:
        method = self.entry.automatic_method
        if method == "exact":
            return "exact"
        if method in {"fts5", "trigram", "keyword", "fuzzy"}:
            return "fuzzy"
        return "unmatched"

    @property
    def best_title(self) -> str:
        return self.best.stem if self.best is not None else "No match found"

    @property
    def confidence(self) -> float | None:
        return self.entry.automatic_confidence


_REVIEW_COLUMNS: list[ColumnSpec[ReviewRow]] = [
    ColumnSpec("Requested title", lambda row: row.entry.filename),
    ColumnSpec("Best match", lambda row: row.best_title),
    ColumnSpec(
        "Confidence",
        lambda row: row.confidence,
        format_fn=lambda value: f"{value:.0%}" if value is not None else "—",
    ),
    ColumnSpec("Method", lambda row: row.entry.automatic_method or "Unmatched"),
    ColumnSpec("Size", lambda row: row.entry.size),
    ColumnSpec("Decision", lambda row: row.entry.decision.title()),
]


class _ReviewFilter(QtCore.QSortFilterProxyModel):
    def __init__(self, parent: QtCore.QObject | None = None) -> None:
        super().__init__(parent)
        self.category = "all"
        self.text = ""

    def filterAcceptsRow(self, source_row, source_parent):
        model = self.sourceModel()
        if model is None:
            return True
        row: ReviewRow = model._records[source_row]  # noqa: SLF001
        if self.category != "all" and row.category != self.category:
            return False
        if self.text:
            needle = self.text.casefold()
            return needle in row.entry.filename.casefold() or needle in row.best_title.casefold()
        return True


def _load_review_task(report_id: str) -> tuple[ReportSummary | None, list[ReviewEntry], dict[int, LibraryItem]]:
    state = MinervaState()
    report = state.get_report(report_id)
    entries = state.get_entries(report_id)
    ids = {
        file_id
        for entry in entries
        for file_id in (entry.selected_file_id, entry.automatic_file_id)
        if file_id is not None
    }
    items = MinervaDB().get_files_by_ids(ids)
    return report, entries, {item.id: item for item in items}


def _candidate_task(entry: ReviewEntry, report: ReportSummary) -> dict[str, Any]:
    result = MinervaDB().match_dat_detailed(
        [DatEntry(filename=entry.filename, size=entry.size)],
        collection=report.collection or "",
        system=report.system or "",
        candidate_limit=8,
    )
    return result["results"][0]


