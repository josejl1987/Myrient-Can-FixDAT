"""
Details panel — collapsible sections for metadata display.
"""

from __future__ import annotations

from dataclasses import dataclass, field

from PyQt6 import QtCore, QtWidgets

from minerva.ui.theme import ThemeTokens
from minerva.ui.density import Density


@dataclass
class Section:
    """A named section with label-value pairs."""
    title: str
    items: list[tuple[str, str]] = field(default_factory=list)


class DetailsPanel(QtWidgets.QWidget):
    """Collapsible sections widget for metadata display.

    Each section has a title and a list of label-value pairs.
    Sections are collapsible by clicking on the header.
    """

    def __init__(
        self,
        sections: list[Section] | None = None,
        tokens: ThemeTokens = ThemeTokens(),
        density: Density = Density.COMPACT,
        parent: QtWidgets.QWidget | None = None,
    ) -> None:
        super().__init__(parent)
        self._tokens = tokens
        self._density = density

        self._layout = QtWidgets.QVBoxLayout(self)
        self._layout.setContentsMargins(0, 0, 0, 0)
        self._layout.setSpacing(density.page_spacing)

        self._section_widgets: list[QtWidgets.QWidget] = []
        if sections:
            for section in sections:
                self.add_section(section)

    def add_section(self, section: Section) -> None:
        """Append a collapsible section."""
        group = QtWidgets.QGroupBox(section.title)
        group.setCheckable(True)
        group.setChecked(True)
        group.setObjectName("surfaceCard")
        group.toggled.connect(lambda checked, g=group: self._on_toggle(g, checked))

        form = QtWidgets.QFormLayout(group)
        form.setContentsMargins(8, 8, 8, 8)
        form.setSpacing(4)

        for label, value in section.items:
            form.addRow(
                QtWidgets.QLabel(label),
                QtWidgets.QLabel(value),
            )

        self._layout.addWidget(group)
        self._section_widgets.append(group)

    def _on_toggle(self, group: QtWidgets.QGroupBox, checked: bool) -> None:
        """Collapse/expand the group content when toggled."""
        for child in group.findChildren(QtWidgets.QWidget):
            if child is not group:
                child.setVisible(checked)

    def apply_tokens(self, tokens: ThemeTokens) -> None:
        self._tokens = tokens

        self._density = density
        self._layout.setSpacing(density.page_spacing)
