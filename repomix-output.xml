    padding: 5px;
}
QMenu::item { padding: 7px 28px 7px 12px; border-radius: 5px; }
QMenu::item:selected { background: {{token.surface_raised}}; }

/* ── Filter chips ──────────────────────────────────────────────────────── */
QPushButton#filterChip {
