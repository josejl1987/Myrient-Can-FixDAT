    # ── Lifecycle and loading ─────────────────────────────────────────

    def activate(self) -> None:
        self._refresh_reports()
        self.refresh()

    def refresh(self) -> None:
        report_id = self.app_state.current_report_id
        if not report_id:
            self._clear_workspace("Choose a report from Reports")
            return
        task = TaskRunner(_load_review_task, report_id)
        task.signals.result.connect(self._on_loaded)
        task.signals.error.connect(lambda error: NotificationBanner.show_error(self, "Review load failed", error))
        self._pool.start(task)

    def _on_loaded(self, payload) -> None:
        report, entries, item_map = payload
        if report is None or report.id != self.app_state.current_report_id:
            return
        self._report = report
        self._rows = [
            ReviewRow(entry, item_map.get(entry.selected_file_id or entry.automatic_file_id or -1))
            for entry in entries
        ]
        self._model.set_records(self._rows)
        self._sync_report_selection(report.id)
        self._update_counts()
        if self._proxy.rowCount() > 0:
            self._view.selectRow(0)
        else:
            self._clear_comparison()

    def _refresh_reports(self) -> None:
        current = self.app_state.current_report_id
        self._report_list.blockSignals(True)
        self._report_list.clear()
        for report in MinervaState().list_reports():
            item = QtWidgets.QListWidgetItem(Icons.reports(), f"{report.name}\n{report.status.title()} · {report.requested_count:,} entries")
            item.setData(Qt.ItemDataRole.UserRole, report.id)
            self._report_list.addItem(item)
            if report.id == current:
                self._report_list.setCurrentItem(item)
        self._report_list.blockSignals(False)

    def _sync_report_selection(self, report_id: str) -> None:
        for index in range(self._report_list.count()):
            item = self._report_list.item(index)
            if item.data(Qt.ItemDataRole.UserRole) == report_id:
                self._report_list.blockSignals(True)
                self._report_list.setCurrentItem(item)
                self._report_list.blockSignals(False)
                break

    def _on_report_changed(self, current, _previous) -> None:
        if current is None:
            return
        report_id = current.data(Qt.ItemDataRole.UserRole)
        if report_id and report_id != self.app_state.current_report_id:
            self.app_state.current_report_id = report_id
            self.refresh()

    # ── Filtering and selection ───────────────────────────────────────

    def _set_text_filter(self, text: str) -> None:
        self._proxy.text = text.strip()
        self._proxy.invalidateFilter()

    def _set_category_filter(self, category: str) -> None:
        self._proxy.category = category
        self._proxy.invalidateFilter()

    def _selected_source_rows(self) -> list[int]:
        rows = {
            self._proxy.mapToSource(index).row()
            for index in self._view.selectionModel().selectedRows()
            if index.isValid()
        }
        return sorted(rows)

    def _current_row(self) -> ReviewRow | None:
        current = self._view.currentIndex()
        if not current.isValid():
            return None
        source = self._proxy.mapToSource(current)
        if not source.isValid() or source.row() >= len(self._rows):
            return None
        return self._rows[source.row()]

    def _on_selection_changed(self, _selected=None, _deselected=None) -> None:
        self._selected_stat.setText(f"Selected\n{len(self._selected_source_rows())}")
        row = self._current_row()
        if row is None:
            self._clear_comparison()
            return
        self._show_requested(row)
        self._load_candidates(row.entry)

    # ── Candidate comparison ──────────────────────────────────────────

    def _show_requested(self, row: ReviewRow) -> None:
        self._requested_title.setText(row.entry.filename)
        self._requested_meta.setText(
            f"Expected size\n{_fmt_bytes(row.entry.size)}\n\n"
            f"Automatic method\n{row.entry.automatic_method or 'Unmatched'}\n\n"
            f"Decision\n{row.entry.decision.title()}"
        )

    def _load_candidates(self, entry: ReviewEntry) -> None:
        if self._report is None:
            return
        self._candidate_generation += 1
        generation = self._candidate_generation
        self._candidate_list.clear()
        self._proposed_title.setText("Loading candidates…")
        self._proposed_meta.clear()
        self._candidate_reasons.set_tags([])
        task = TaskRunner(_candidate_task, entry, self._report)
        task.signals.result.connect(lambda result, value=generation: self._on_candidates_loaded(value, result))
        task.signals.error.connect(lambda error: NotificationBanner.show_error(self, "Candidate search failed", error))
        self._pool.start(task)

    def _on_candidates_loaded(self, generation: int, result: dict[str, Any]) -> None:
        if generation != self._candidate_generation:
            return
        self._candidate_list.clear()
        candidates = result.get("candidates", [])
        for candidate in candidates:
            item = QtWidgets.QListWidgetItem(
                f"{candidate['confidence']:.0%}  ·  {candidate['title']}  ·  {candidate['system']}"
            )
            item.setData(Qt.ItemDataRole.UserRole, candidate)
            self._candidate_list.addItem(item)
        if self._candidate_list.count():
            self._candidate_list.setCurrentRow(0)
        else:
            self._selected_candidate = None
            self._proposed_title.setText("No candidate found")
            self._proposed_meta.setText("Try searching the Library or leave this entry unmatched.")
            self._candidate_reasons.set_tags([])

    def _on_candidate_changed(self, current, _previous) -> None:
        self._selected_candidate = current.data(Qt.ItemDataRole.UserRole) if current is not None else None
        candidate = self._selected_candidate
        if not candidate:
            return
        self._proposed_title.setText(candidate["title"])
        if candidate.get("_cdr_url"):
            self._proposed_meta.setText(
                f"{candidate['collection']} / {candidate['system']}\n"
                f"CDRomance candidate \u2014 approve to open in browser"
            )
        else:
            self._proposed_meta.setText(
                f"{candidate['collection']} / {candidate['system']}\n"
                f"{_fmt_bytes(candidate['size'])} · {candidate['method'].title()} · {candidate['confidence']:.1%}"
            )
        self._candidate_reasons.set_tags(list(candidate.get("reasons", [])))

    def _approve_candidate(self) -> None:
        row = self._current_row()
        candidate = self._selected_candidate
        if row is None or candidate is None:
            return
        # CDRomance candidate — open in browser/embedded view
        cdr_url = candidate.get("_cdr_url")
        if cdr_url:
            self._open_cdr_page(cdr_url, row)
            return
        decision = "accept" if candidate.get("method") == "exact" else "fuzzy"
        self._apply_decisions([(row.entry.id, decision, int(candidate["file_id"]))])

    def _open_cdr_page(self, url: str, row: ReviewRow) -> None:
        """Open a CDRomance page in the embedded browser (or system fallback)."""
        try:
            from minerva.ui.widgets.repo_browser import _HAS_WEBENGINE, RepoDialog
            if _HAS_WEBENGINE:
                dialog = RepoDialog(url, self)
                dialog.download_completed.connect(
                    lambda fname, fpath: self._apply_decisions(
                        [(row.entry.id, "fuzzy", -1)]
                    )
                )
                dialog.exec()
                return
        except ImportError:
            pass
        QtGui.QDesktopServices.openUrl(QtCore.QUrl(url))
        self._apply_decisions([(row.entry.id, "fuzzy", -1)])

    def _search_source(self) -> None:
        row = self._current_row()
        if row is None:
            return

        game_name: str | None = None
        system: str | None = None
        if row.best is not None:
            game_name = _META_PARENS.sub("", row.best.stem).strip()
            system = row.best.system
        if not game_name:
            game_name = _clean_search_term(row.entry.filename)
            system = getattr(row.entry, "system", None)
        self._cdr_slug = _SYSTEM_TO_CDR_SLUG.get(system or "")

        NotificationBanner.show_info(self, "CDRomance", "Searching\u2026")

        task = TaskRunner(_cdr_search_task, game_name, self._cdr_slug)
        task.signals.result.connect(self._on_cdr_search_result)
        task.signals.error.connect(
            lambda err: NotificationBanner.show_error(self, "CDRomance search failed", str(err))
        )
        self._pool.start(task)

    def _on_cdr_search_result(self, payload: object) -> None:
        data: list[dict] = payload  # type: ignore[assignment]
        if not data:
            NotificationBanner.show_info(self, "No results", "Try a different search term on CDRomance")
            return

        self._candidate_list.clear()
        for entry in data:
            title = entry.get("title", "Unknown")
            page_url = entry.get("url", "")
            parts = page_url.rstrip("/").split("/")
            platform = parts[-2] if len(parts) >= 2 else ""
            item = QtWidgets.QListWidgetItem(f"[CDR] {title}")
            item.setData(Qt.ItemDataRole.UserRole, {
                "_cdr_url": page_url,
                "title": title,
                "collection": platform,
                "system": self._cdr_slug or platform,
                "method": "cdromance",
                "confidence": 0.5,
                "size": 0,
                "reasons": ["CDRomance candidate"],
            })
            item.setToolTip(page_url)
            self._candidate_list.addItem(item)

        if self._candidate_list.count():
            self._candidate_list.setCurrentRow(0)

        NotificationBanner.show_info(
            self, "CDRomance",
            f"{len(data)} candidate(s) found. Select one and approve."
        )

    def _on_repo_downloaded(self, filename: str, path: str) -> None:
        """Save a completed repo download so it appears in the Downloads tab."""
        from datetime import datetime, timezone

        from minerva.domain.downloads import DownloadStatus, QueueRecord
        from minerva_state import MinervaState

        now = datetime.now(timezone.utc).isoformat()
        import uuid

        record = QueueRecord(
            id=uuid.uuid4().hex,
            file_id=-1,  # browser download — not in the library index
            status=DownloadStatus.COMPLETED.value,
            destination=path,
            created_at=now,
            updated_at=now,
        )
        MinervaState().save_queue_record(record)
        shell = self.window()
        if hasattr(shell, "download_controller") and shell.download_controller is not None:
            shell.download_controller._emit_changed()

    # ── Decisions and bulk operations ─────────────────────────────────

    def _approve_selected(self) -> None:
        updates: list[tuple[str, str, int | None]] = []
        for source_row in self._selected_source_rows():
            row = self._rows[source_row]
            file_id = row.entry.selected_file_id or row.entry.automatic_file_id
            if file_id is None:
                continue
            decision = "accept" if row.category == "exact" else "fuzzy"
            updates.append((row.entry.id, decision, file_id))
        self._apply_decisions(updates)

    def _ignore_selected(self) -> None:
        updates = [
            (self._rows[source_row].entry.id, "reject", None)
            for source_row in self._selected_source_rows()
        ]
        self._apply_decisions(updates)

    def _approve_all_exact(self) -> None:
        updates = [
            (row.entry.id, "accept", row.entry.selected_file_id or row.entry.automatic_file_id)
            for row in self._rows
            if row.category == "exact"
            and row.entry.decision == "pending"
            and (row.entry.selected_file_id or row.entry.automatic_file_id) is not None
        ]
        self._confirm_and_apply(updates, "Approve exact matches")

    def _approve_fuzzy_threshold(self) -> None:
        threshold = self._threshold.value() / 100.0
        updates = [
            (row.entry.id, "fuzzy", row.entry.selected_file_id or row.entry.automatic_file_id)
            for row in self._rows
            if row.category == "fuzzy"
            and row.entry.decision == "pending"
            and (row.entry.automatic_confidence or 0.0) >= threshold
            and (row.entry.selected_file_id or row.entry.automatic_file_id) is not None
        ]
        self._confirm_and_apply(updates, f"Approve fuzzy matches at or above {threshold:.0%}")

    def _confirm_and_apply(self, updates: list[tuple[str, str, int | None]], title: str) -> None:
        if not updates:
            NotificationBanner.show_info(self, "Nothing to change", "No pending entries match this action")
            return
        if QtWidgets.QMessageBox.question(
            self,
            title,
            f"Apply this decision to {len(updates):,} entries?",
        ) != QtWidgets.QMessageBox.StandardButton.Yes:
            return
        self._apply_decisions(updates)

    def _apply_decisions(self, updates: list[tuple[str, str, int | None]]) -> None:
        if not updates:
            return
        MinervaState().update_entry_decisions(updates)
        self._update_report_status()
        NotificationBanner.show_success(self, "Review updated", f"Updated {len(updates):,} entries")
        self.refresh()

    def _update_report_status(self) -> None:
        if self._report is None:
            return
        entries = MinervaState().get_entries(self._report.id)
        status = "reviewed" if entries and all(entry.decision != "pending" for entry in entries) else "draft"
        MinervaState().update_report(self._report.id, status=status)

    # ── Export and queue ───────────────────────────────────────────────

    def _approved_entries(self, selected_only: bool = False) -> list[ReviewEntry]:
        selected = set(self._selected_source_rows())
        return [
            row.entry
            for index, row in enumerate(self._rows)
            if row.entry.decision in {"accept", "fuzzy"}
            and (not selected_only or index in selected)
            and (row.entry.selected_file_id or row.entry.automatic_file_id) is not None
        ]

    def _queue_approved(self) -> None:
        selected_only = bool(self._selected_source_rows())
        entries = self._approved_entries(selected_only=selected_only)
        if not entries:
            NotificationBanner.show_warning(self, "Nothing approved", "Approve matches before adding them to the queue")
            return
        shell = self.window()
        controller = getattr(shell, "download_controller", None)
        if controller is None:
            NotificationBanner.show_error(self, "Downloads unavailable", "The qBittorrent controller is not initialised")
            return
        ids = [entry.selected_file_id or entry.automatic_file_id for entry in entries]
        items = {item.id: item for item in MinervaDB().get_files_by_ids(ids)}
        output_root = Path(QtCore.QSettings("MinervaFixDAT", "MinervaGUI").value("output_dir", "downloads", str))
        queue = []
        for entry in entries:
            file_id = entry.selected_file_id or entry.automatic_file_id
            item = items.get(file_id)
            if item is None:
                continue
            destination = output_root / item.collection / item.system / item.basename
            queue.append((item.id, str(destination), entry.id))
        controller.add_many_to_queue(queue)
        NotificationBanner.show_success(self, "Added to queue", f"Queued {len(queue):,} reviewed files")

    def _export_unmatched(self) -> None:
        if self._report is None:
            return
        entries = [
            row.entry
            for row in self._rows
            if row.category == "unmatched" or row.entry.decision == "reject"
        ]
        if not entries:
            NotificationBanner.show_info(self, "No unmatched entries", "Every entry currently has an accepted candidate")
            return
        path, _ = QtWidgets.QFileDialog.getSaveFileName(
            self,
            "Export unmatched DAT",
            f"{self._report.name}-unmatched.dat",
            "DAT files (*.dat)",
        )
        if not path:
            return
        rows = [
            {"stem": stem_from_romname(entry.filename), "basename": entry.filename, "size": entry.size}
            for entry in entries
        ]
        xml = MinervaDB().build_synthetic_dat(
            rows,
            f"{self._report.name} unmatched",
            self._report.system,
            self._report.collection,
        )
        Path(path).write_text(xml, encoding="utf-8")
        NotificationBanner.show_success(self, "Unmatched DAT exported", path)

    def _generate_final_dat(self) -> None:
        if self._report is None:
            return
        entries = self._approved_entries()
        ids = [entry.selected_file_id or entry.automatic_file_id for entry in entries]
        items = MinervaDB().get_files_by_ids(ids)
        if not items:
            NotificationBanner.show_warning(self, "Nothing approved", "Approve at least one entry first")
            return
        path, _ = QtWidgets.QFileDialog.getSaveFileName(
            self,
            "Generate final DAT",
            f"{self._report.name}-reviewed.dat",
            "DAT files (*.dat)",
        )
        if not path:
            return
        rows = [{"stem": item.stem, "basename": item.basename, "size": item.size} for item in items]
        xml = MinervaDB().build_synthetic_dat(
            rows,
            f"{self._report.name} reviewed",
            self._report.system,
            self._report.collection,
        )
        Path(path).write_text(xml, encoding="utf-8")
        NotificationBanner.show_success(self, "Final DAT generated", path)

    # ── Counters and helpers ──────────────────────────────────────────

    def _update_counts(self) -> None:
        exact = sum(row.category == "exact" for row in self._rows)
        fuzzy = sum(row.category == "fuzzy" for row in self._rows)
        unmatched = sum(row.category == "unmatched" for row in self._rows)
        ignored = sum(row.entry.decision == "reject" for row in self._rows)
        approved = sum(row.entry.decision in {"accept", "fuzzy"} for row in self._rows)
        remaining = sum(row.entry.decision == "pending" for row in self._rows)
        self._exact_card.set_value(f"{exact:,}")
        self._fuzzy_card.set_value(f"{fuzzy:,}")
        self._unmatched_card.set_value(f"{unmatched:,}")
        self._ignored_card.set_value(f"{ignored:,}")
        self._selected_stat.setText(f"Selected\n{len(self._selected_source_rows())}")
        self._approved_stat.setText(f"Approved\n{approved:,}")
        self._ignored_stat.setText(f"Ignored\n{ignored:,}")
        self._remaining_stat.setText(f"Remaining\n{remaining:,}")
        for key, count in (("all", len(self._rows)), ("exact", exact), ("fuzzy", fuzzy), ("unmatched", unmatched)):
            label = key.title() if key != "all" else "All"
            self._filter_buttons[key].setText(f"{label} {count:,}")

    def _clear_workspace(self, message: str) -> None:
        self._report = None
        self._rows = []
        self._model.set_records([])
        self._clear_comparison()
        self._requested_title.setText(message)
        self._update_counts()

    def _clear_comparison(self) -> None:
        self._selected_candidate = None
        self._requested_title.setText("Select an entry")
        self._requested_meta.clear()
        self._proposed_title.setText("No candidate selected")
        self._proposed_meta.clear()
        self._candidate_list.clear()
        self._candidate_reasons.set_tags([])

    def _copy_selected_cell(self) -> None:
        index = self._view.currentIndex()
        if index.isValid():
            source = self._proxy.mapToSource(index)
            text = str(source.data(Qt.ItemDataRole.DisplayRole) or "")
            QtWidgets.QApplication.clipboard().setText(text)

    def _go_back(self) -> None:
        from minerva.app.page_id import PageId

        shell = self.window()
        if hasattr(shell, "show_page"):
            shell.show_page(PageId.REPORTS)


def _fmt_bytes(value: int) -> str:
    size = float(value)
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if size < 1024 or unit == "TB":
            return f"{int(size)} B" if unit == "B" else f"{size:.1f} {unit}"
        size /= 1024
    return f"{size:.1f} TB"
