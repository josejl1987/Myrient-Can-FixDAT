                CollectionsPageState.EMPTY: 1,
                CollectionsPageState.ERROR: 2,
                CollectionsPageState.RESULTS: 3,
            }[state]
        )

    def activate(self) -> None:
        self.refresh()

    def prepare_close(self) -> None:
        self._settings.setValue("collections/splitter_sizes", self._splitter.sizes())
        self._settings.setValue(
            "collections/selected_collection", self._selected_collection or ""
        )
        self._settings.setValue(
            "collections/system_header", self._system_view.horizontalHeader().saveState()
        )

    def _restore_view_state(self) -> None:
        sizes = self._settings.value("collections/splitter_sizes")
        if isinstance(sizes, list) and sizes:
            self._splitter.setSizes([int(value) for value in sizes])
        header_state = self._settings.value("collections/system_header")
        if header_state is not None:
            self._system_view.horizontalHeader().restoreState(header_state)

    def refresh(self) -> None:
        self._set_state(CollectionsPageState.LOADING)
        try:
            self._db = MinervaDB(self._index_path())
            overview = self._db.get_index_overview()
            summaries = self._db.get_collection_summaries()
            runs = self._db.get_index_runs(5)
            self._references = MinervaState().list_reference_dats()
        except Exception as exc:
            self._error_state.set_description(str(exc))
            self._set_state(CollectionsPageState.ERROR)
            return

        self._apply_overview(overview)
        self._navigator.set_summaries(summaries)
        self._update_reference_card(self._references)
        self._update_performance_card(runs)
        self._set_state(
            CollectionsPageState.RESULTS if summaries else CollectionsPageState.EMPTY
        )
        if summaries:
            self._navigator.select_name(self._selected_collection)
        else:
            self._system_model.set_records([])
            self._inspector.clear()

    def _apply_overview(self, overview: IndexOverview) -> None:
        self._card_collections.set_value(f"{overview.collections:,}")
        self._card_systems.set_value(f"{overview.systems:,}")
        self._card_files.set_value(f"{overview.files:,}")
        self._card_db_size.set_value(self._format_size(overview.database_size))
        if overview.last_build:
            stamp = overview.last_build.strftime("%Y-%m-%d %H:%M")
            self._card_db_size.set_subtitle(f"Last rebuilt {stamp}")
            self._header.set_subtitle(
                f"{overview.collections:,} collections \xb7 {overview.systems:,} systems"
                f" \xb7 Last rebuilt {stamp}"
            )
        else:
            self._card_db_size.set_subtitle("No completed build recorded")

    def _on_collection_selected(self, summary: CollectionSummary) -> None:
        if self._db is None:
            return
        self._selected_collection = summary.name
        expected = MinervaState().expected_counts()
        systems: list[SystemSummary] = []
        for item in self._db.get_system_summaries(summary.name):
            expected_files = expected.get((item.collection, item.system))
            systems.append(
                SystemSummary(
                    item.collection,
                    item.system,
                    item.files,
                    item.last_update,
                    item.source_present,
                    expected_files,
                )
            )
        self._system_model.set_records(systems)
        self._systems_title.setText("Systems")
        self._systems_scope.setText(summary.name)
        self._systems_count.setText(f"{len(systems):,}")
        counts = {
            "all": len(systems),
            "covered": sum(
                1 for item in systems if item.coverage is not None and item.coverage >= 1.0
            ),
            "missing": sum(1 for item in systems if not item.source_present),
            "unreferenced": sum(1 for item in systems if item.expected_files is None),
        }
        self._system_segments.set_counts(counts)
        references = [
            reference
            for reference in self._references
            if reference.collection == summary.name
        ]
        self._inspector.set_collection(summary, systems, references, self._torrent_dir())

    def _update_reference_card(self, references: list[ReferenceDat]) -> None:
        if not references:
            self._imports_card.set_state(
                "0",
                "Import DATs to calculate expected counts and coverage.",
                "None",
                BadgeKind.NEUTRAL,
            )
            return
        latest = references[0]
        stamp = self._display_timestamp(latest.imported_at)
        self._imports_card.set_state(
            f"{len(references):,}",
            f"Latest: {latest.name} \xb7 {latest.entry_count:,} entries \xb7 {stamp}",
            "Available",
            BadgeKind.SUCCESS,
        )

    def _update_performance_card(self, runs: list[dict]) -> None:
        latest = runs[0] if runs else None
        if not latest:
            self._performance_card.set_state(
                "No history",
                "Rebuild the index to record timing and source statistics.",
                "Unknown",
            )
            return
        elapsed = (latest.get("elapsed_ms") or 0) / 1000
        errors = latest.get("error_count", 0) or 0
        status = str(latest.get("status", "unknown")).title()
        self._performance_card.set_state(
            f"{elapsed:.1f} s",
            f"{latest.get('file_count', 0):,} files \xb7 "
            f"{latest.get('torrent_count', 0):,} torrents \xb7 {errors:,} errors",
            status,
            BadgeKind.SUCCESS if status.casefold() == "completed" and not errors else BadgeKind.WARNING,
        )

    def _on_rebuild(self) -> None:
        if (
            QtWidgets.QMessageBox.question(
                self,
                "Rebuild index",
                "Build a replacement index from the configured torrent directory?\n"
                "The current database remains available until validation succeeds.",
                QtWidgets.QMessageBox.StandardButton.Yes
                | QtWidgets.QMessageBox.StandardButton.Cancel,
                QtWidgets.QMessageBox.StandardButton.Yes,
            )
            != QtWidgets.QMessageBox.StandardButton.Yes
        ):
            return
        self._rebuild_btn.setEnabled(False)
        self._rebuild_btn.setText("Rebuilding\u2026")
        self._performance_card.set_busy(True, "Rebuilding\u2026")
        self._performance_card.set_state(
            "In progress",
            "Parsing torrent metadata and building a validated replacement database.",
            "Running",
            BadgeKind.WARNING,
        )
        task = TaskRunner(
            _atomic_rebuild_task, str(self._torrent_dir()), str(self._index_path())
        )
        task.signals.result.connect(self._on_rebuild_complete)
        task.signals.error.connect(self._on_rebuild_error)
        self._pool.start(task)

    def _on_rebuild_complete(self, path: object) -> None:
        self._rebuild_btn.setEnabled(True)
        self._rebuild_btn.setText("Rebuild index")
        self._performance_card.set_busy(False, "Open index folder")
        self._app_state.index_state = {"ready": True, "path": str(path)}
        NotificationBanner.show_success(self, "Index rebuilt", str(path))
        self.refresh()

    def _on_rebuild_error(self, details: str) -> None:
        self._rebuild_btn.setEnabled(True)
        self._rebuild_btn.setText("Rebuild index")
        self._performance_card.set_busy(False, "Open index folder")
        self._performance_card.set_state(
            "Failed", "The previous index remains intact.", "Error", BadgeKind.ERROR
        )
        NotificationBanner.show_error(self, "Index rebuild failed", details, duration=8000)

    def _on_import_dat(self) -> None:
        paths, _ = QtWidgets.QFileDialog.getOpenFileNames(
            self, "Import reference DAT", "", "DAT files (*.dat)"
        )
        if not paths:
            return
        state = MinervaState()
        imported = 0
        for raw_path in paths:
            try:
                path = Path(raw_path)
                info = parse_dat_file(path)
                state.save_reference_dat(
                    ReferenceDat(
                        id=uuid.uuid4().hex,
                        path=str(path),
                        name=info.name or path.stem,
                        collection=info.collection or self._selected_collection,
                        system=info.system,
                        entry_count=len(info.entries),
                        imported_at=datetime.now(timezone.utc).isoformat(),
                    )
                )
                state.add_event("index", f"Imported reference DAT {path.name}")
                imported += 1
            except Exception as exc:
                NotificationBanner.show_error(
                    self, "DAT import failed", f"{raw_path}: {exc}"
                )
        if imported:
            NotificationBanner.show_success(
                self, "Reference DATs imported", f"Imported {imported} file(s)"
            )
            self.refresh()

    def _on_verify_integrity(self) -> None:
        self._health_card.set_busy(True, "Checking\u2026")
        self._health_card.set_state(
            "Running",
            "SQLite quick_check is validating index consistency.",
            "Checking",
            BadgeKind.WARNING,
        )
        task = TaskRunner(_integrity_task, str(self._index_path()))
        task.signals.result.connect(self._on_integrity_result)
        task.signals.error.connect(self._on_integrity_error)
        self._pool.start(task)

    def _on_integrity_result(self, payload: object) -> None:
        self._health_card.set_busy(False, "Run integrity check")
        result = payload if isinstance(payload, dict) else {}
        if result.get("ok"):
            counts = result.get("table_counts", {})
            self._health_card.set_state(
                "Healthy",
                f"{counts.get('files', 0):,} file rows \xb7 "
                f"{counts.get('torrents', 0):,} torrent sources",
                "Passed",
                BadgeKind.SUCCESS,
            )
        else:
            self._health_card.set_state(
                "Problems found",
                str(result.get("quick_check", "Unknown integrity error")),
                "Failed",
                BadgeKind.ERROR,
            )

    def _on_integrity_error(self, details: str) -> None:
        self._health_card.set_busy(False, "Run integrity check")
        self._health_card.set_state("Check failed", details, "Error", BadgeKind.ERROR)

    def _on_check_sources(self) -> None:
        self._missing_card.set_busy(True, "Verifying\u2026")
        self._missing_card.set_state(
            "Running",
            "Checking configured torrent source paths.",
            "Checking",
            BadgeKind.WARNING,
        )
        task = TaskRunner(
            _missing_sources_task,
            str(self._index_path()),
            str(self._torrent_dir()),
        )
        task.signals.result.connect(self._on_missing_sources_result)
        task.signals.error.connect(self._on_missing_sources_error)
        self._pool.start(task)

    def _on_missing_sources_result(self, payload: object) -> None:
        self._sources_checked = True
        self._missing_sources = list(payload) if isinstance(payload, list) else []
        count = len(self._missing_sources)
        self._missing_card.set_busy(False, "View missing paths" if count else "Verify again")
        self._missing_card.set_state(
            f"{count:,}",
            "All indexed torrent sources are present."
            if count == 0
            else f"{count:,} indexed torrent source(s) cannot be found on disk.",
            "Healthy" if count == 0 else "Attention",
            BadgeKind.SUCCESS if count == 0 else BadgeKind.WARNING,
        )
        NotificationBanner.show_success(
            self, "Path verification complete", f"{count} missing source(s)"
        )

    def _on_missing_sources_error(self, details: str) -> None:
        self._missing_card.set_busy(False, "Verify paths")
        self._missing_card.set_state("Check failed", details, "Error", BadgeKind.ERROR)
        NotificationBanner.show_error(self, "Path verification failed", details)

    def _on_missing_card_action(self) -> None:
        if self._sources_checked and self._missing_sources:
            self._show_missing_paths()
        else:
            self._on_check_sources()

    def _show_missing_paths(self) -> None:
        if not self._sources_checked:
            self._on_check_sources()
            return
        dialog = QtWidgets.QDialog(self)
        dialog.setWindowTitle("Missing source torrents")
        dialog.resize(820, 460)
        layout = QtWidgets.QVBoxLayout(dialog)
        title = QtWidgets.QLabel(
            "No paths are missing."
            if not self._missing_sources
            else f"{len(self._missing_sources):,} source torrent(s) are missing"
        )
        title.setObjectName("sectionTitle")
        layout.addWidget(title)
        table = QtWidgets.QTableWidget(0, 2)
        table.setHorizontalHeaderLabels(["Torrent", "Expected path"])
        table.verticalHeader().hide()
        table.horizontalHeader().setSectionResizeMode(
            0, QtWidgets.QHeaderView.ResizeMode.ResizeToContents
        )
        table.horizontalHeader().setSectionResizeMode(
            1, QtWidgets.QHeaderView.ResizeMode.Stretch
        )
        for entry in self._missing_sources:
            row = table.rowCount()
            table.insertRow(row)
            table.setItem(row, 0, QtWidgets.QTableWidgetItem(entry["torrent"]))
            table.setItem(row, 1, QtWidgets.QTableWidgetItem(entry["path"]))
        layout.addWidget(table)
        buttons = QtWidgets.QDialogButtonBox(
            QtWidgets.QDialogButtonBox.StandardButton.Close
        )
        buttons.rejected.connect(dialog.reject)
        layout.addWidget(buttons)
        dialog.exec()

    def _open_source_folder(self) -> None:
        QtGui.QDesktopServices.openUrl(
            QtCore.QUrl.fromLocalFile(str(self._torrent_dir()))
        )

    def _open_index_folder(self) -> None:
        QtGui.QDesktopServices.openUrl(
            QtCore.QUrl.fromLocalFile(str(self._index_path().parent))
        )

    def _remove_collection(self, collection: str | None = None) -> None:
        name = collection or self._selected_collection
        if not name or self._db is None:
            return
        if (
            QtWidgets.QMessageBox.warning(
                self,
                "Remove collection",
                f'Remove all indexed rows for "{name}"?\n'
                "The source torrent files will not be deleted.",
                QtWidgets.QMessageBox.StandardButton.Yes
                | QtWidgets.QMessageBox.StandardButton.Cancel,
                QtWidgets.QMessageBox.StandardButton.Cancel,
            )
            != QtWidgets.QMessageBox.StandardButton.Yes
        ):
            return
        removed = self._db.remove_collection(name)
        NotificationBanner.show_success(
            self, "Collection removed", f"Removed {removed:,} indexed rows"
        )
        self._selected_collection = None
        self._inspector.clear()
        self.refresh()

    @staticmethod
    def _display_timestamp(value: str) -> str:
        try:
            parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
            return parsed.astimezone().strftime("%Y-%m-%d %H:%M")
        except (ValueError, TypeError):
            return value

    @staticmethod
    def _format_size(size: int) -> str:
        value = float(size)
        for unit in ("B", "KB", "MB", "GB", "TB"):
            if value < 1024 or unit == "TB":
                return f"{value:.1f} {unit}" if unit != "B" else f"{int(value)} B"
            value /= 1024
        return f"{value:.1f} TB"

    def _torrent_dir(self) -> Path:
        return Path(self._settings.value("torrent_dir", str(DEFAULT_TORRENT_DIR), str))

    def _index_path(self) -> Path:
        return Path(self._settings.value("index_path", str(DEFAULT_INDEX_PATH), str))
