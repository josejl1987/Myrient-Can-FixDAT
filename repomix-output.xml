import re as _re

# Region/language markers to remove entirely
_REGION_TAGS = _re.compile(
    r"\b(USA|Europe|Japan|World|En|Fr|De|Es|It|Nl|Pt|Sv|No|Da|Fi|Pl|"
    r"Beta|Proto|Sample|Demo|Rev\s?\d+|v\d[\d.]*|"
    r"En,\w+(?:,\w+)*)\b", _re.IGNORECASE,
)
# Scene group suffix: last hyphen-segment that is ALL CAPS/digits
_SCENE_GROUP = _re.compile(r"[-_][A-Z0-9]{2,}$")
# Parentheses/brackets containing pure metadata (not subtitle)
_META_PARENS = _re.compile(r"\s*[\(\[][^\)\]]*[\)\]]")
# Normalise underscores and collapse whitespace
_UNDERSCORES = _re.compile(r"_+")


def _clean_search_term(filename: str) -> str:
    """Strip scene tags, region markers, and parens from a DAT filename.

    ``"Fate_Extra_USA_PSP-PLAYASiA.iso"`` → ``"Fate Extra"``
    ``"Super_Mario_World_(Europe)_(Rev_1).zip"`` → ``"Super Mario World"``
    ``"Ace_Combat_3_-_Electrosphere_(USA).iso"`` → ``"Ace Combat 3 - Electrosphere"``
    """
    stem = Path(filename).stem
    stem = _SCENE_GROUP.sub("", stem)
    stem = _UNDERSCORES.sub(" ", stem)
    stem = _META_PARENS.sub("", stem)
    stem = _REGION_TAGS.sub("", stem)
    stem = _re.sub(r"\s+", " ", stem).strip()
    return stem


def _cdromance_search_url(game_name: str, system: str | None = None) -> str:
    """Build the optimal CDRomance search URL, scoped to platform slug."""
    from urllib.parse import quote

    slug = _SYSTEM_TO_CDR_SLUG.get(system or "")
    encoded = quote(game_name)
    if slug:
        return f"https://cdromance.org/{slug}/?s={encoded}"
    return f"https://cdromance.org/?s={encoded}"
from minerva.ui.models.delegates import DisplayDelegate, SizeDelegate
