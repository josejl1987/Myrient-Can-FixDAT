/* Library workspace. */
QFrame#libraryToolbar,
QFrame#librarySummaryBar,
QFrame#facetPanel {
    background: {{token.surface}};
    border: 1px solid {{token.border}};
    border-radius: {{token.radius_lg}};
}
QFrame#libraryToolbar { min-height: 54px; }
QFrame#libraryToolbar QLineEdit#librarySearchInput,
QLineEdit#reportNavigatorSearch,
QLineEdit#reportSearch {
    background: {{token.surface_sunken}};
    border-color: {{token.border}};
}
QComboBox#libraryFilterCombo,
QComboBox#reportFilterCombo {
    min-width: 155px;
    background: {{token.surface_sunken}};
    border-color: {{token.border}};
}
QFrame#librarySummaryBar { min-height: 58px; max-height: 66px; }
QLabel#librarySummaryIcon {
    background: {{token.surface_raised}};
    border: 1px solid {{token.border}};
    border-radius: {{token.radius_md}};
}
QLabel#librarySummaryValue {
    color: {{token.text}};
    font-size: 14px;
    font-weight: 700;
}
QLabel#librarySummaryLabel {
    color: {{token.text_subtle}};
    font-size: 10px;
    font-weight: 600;
}
QFrame#libraryResultsHeader {
    background: {{token.surface}};
    border: none;
    border-bottom: 1px solid {{token.border}};
    border-top-left-radius: {{token.radius_lg}};
    border-top-right-radius: {{token.radius_lg}};
}
QTableView#libraryTable,
QTableView#reportEntries {
    border: none;
    border-radius: 0;
}
QTableView#libraryTable::item:selected,
QTableView#reportEntries::item:selected {
    background: {{token.info_bg}};
    color: {{token.text}};
}
QWidget#libraryPagination {
    background: {{token.surface}};
    border-top: 1px solid {{token.border}};
    padding: 8px 10px;
}
QScrollArea#facetScroll,
QScrollArea#facetScroll > QWidget > QWidget {
    background: transparent;
    border: none;
}
QFrame#facetGroup { background: transparent; border: none; }
QToolButton#facetHeader {
    min-height: 30px;
    background: transparent;
    color: {{token.text}};
    border: none;
    padding: 4px 2px;
    text-align: left;
    font-size: 11px;
    font-weight: 700;
}
QToolButton#facetHeader:hover { color: {{token.info_fg}}; }
QListWidget#facetList {
    background: transparent;
    border: none;
    color: {{token.text}};
}
QListWidget#facetList::item {
    min-height: 26px;
    padding: 2px 4px;
    border: none;
    border-radius: {{token.radius_sm}};
}
QListWidget#facetList::item:hover { background: {{token.surface_hover}}; }
QListWidget#facetList::item:selected { background: {{token.info_bg}}; }
QLabel#libraryInspectorTitle {
    color: {{token.text}};
    font-size: 16px;
    font-weight: 700;
}
QLabel#libraryInspectorSubtitle,
QLabel#libraryInspectorKey {
    color: {{token.text_muted}};
    font-size: 11px;
}
QLabel#libraryInspectorValue { color: {{token.text}}; font-size: 11px; }
