/* Minerva application-wide foundation. */

/* ── Global canvas ─────────────────────────────────────────────────────── */
QWidget {
    background: transparent;
    color: {{token.text}};
    font-family: "{{token.body_font}}";
    font-size: 13px;
}
QMainWindow,
QDialog,
QWidget#pageSurface,
QWidget#shellCentral {
    background-color: {{token.background}};
}
QStackedWidget,
QScrollArea,
QScrollArea > QWidget,
QScrollArea > QWidget > QWidget {
    background: transparent;
    border: none;
}

/* ── Status bar ───────────────────────────────────────────────────────── */
QStatusBar {
    min-height: 26px;
    max-height: 26px;
    background-color: {{token.sidebar}};
    color: {{token.text_subtle}};
    border-top: 1px solid {{token.border}};
    font-size: 11px;
    padding: 0 12px;
}
QStatusBar::item { border: none; }

/* ── Typography ───────────────────────────────────────────────────────── */
QLabel {
    color: {{token.text}};
    background: transparent;
}
QLabel#pageEyebrow {
    color: {{token.accent}};
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.4px;
}
QLabel#pageTitle {
    color: {{token.text}};
    font-family: "{{token.heading_font}}";
    font-size: 30px;
    font-weight: 700;
}
QLabel#pageSubtitle {
    color: {{token.text_muted}};
    font-size: 13px;
}
QLabel#sectionTitle,
QLabel#panelTitle {
    color: {{token.text}};
    font-size: 14px;
    font-weight: 650;
}
QLabel#mutedLabel,
QLabel#metricSubtitle {
    color: {{token.text_muted}};
    font-size: 11px;
}
QLabel#subtleLabel {
    color: {{token.text_subtle}};
    font-size: 11px;
}
QLabel#metricTitle {
    color: {{token.text_muted}};
    font-size: 11px;
    font-weight: 600;
}
QLabel#metricValue {
    color: {{token.text}};
    font-size: 22px;
    font-weight: 700;
}
QLabel#panelCount {
    min-width: 20px;
    color: {{token.text_muted}};
    background: {{token.surface_raised}};
    border: 1px solid {{token.border}};
    border-radius: 10px;
    padding: 1px 7px;
    font-size: 10px;
    font-weight: 700;
}
QLabel#resultsCount {
    color: {{token.text_muted}};
    font-size: 11px;
    min-width: 58px;
}
QLabel#emptyInline {
    color: {{token.text_muted}};
    padding: 24px 10px;
}
QLabel#inspectorTitle {
    color: {{token.text}};
    font-size: 16px;
    font-weight: 700;
}
QLabel#inspectorSectionTitle {
    color: {{token.text_subtle}};
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.8px;
}
QLabel#inspectorKey {
    color: {{token.text_muted}};
    font-size: 11px;
    min-width: 82px;
}
QLabel#inspectorValue {
    color: {{token.text}};
    font-size: 11px;
}

/* ── Dividers ─────────────────────────────────────────────────────────── */
QFrame#separator,
QFrame#sidebarSeparator,
QFrame#summarySeparator {
    background-color: {{token.border}};
    border: none;
    max-height: 1px;
}

/* ── Menus and tooltips ───────────────────────────────────────────────── */
QToolTip {
    background: {{token.surface_raised}};
    color: {{token.text}};
    border: 1px solid {{token.border_strong}};
    padding: 6px 9px;
    border-radius: {{token.radius_sm}};
    font-size: 11px;
}
QMenu {
    background: {{token.surface}};
    color: {{token.text}};
    border: 1px solid {{token.border_strong}};
    border-radius: {{token.radius_md}};
    padding: 6px;
}
QMenu::item {
    min-height: 26px;
    padding: 5px 30px 5px 12px;
    border-radius: {{token.radius_sm}};
}
QMenu::item:selected {
    background: {{token.surface_hover}};
    color: {{token.text}};
}
QMenu::item:disabled { color: {{token.disabled_text}}; }
QMenu::separator {
    height: 1px;
    background: {{token.border}};
    margin: 5px 8px;
}

/* ── Splitters and scrollbars ─────────────────────────────────────────── */
QSplitter::handle { background: transparent; }
QSplitter::handle:horizontal { width: 10px; }
QSplitter::handle:vertical { height: 10px; }
QScrollBar:vertical {
    background: transparent;
    width: 9px;
    margin: 2px;
    border: none;
}
QScrollBar::handle:vertical {
    background: {{token.scrollbar}};
    border-radius: 4px;
    min-height: 34px;
}
QScrollBar::handle:vertical:hover { background: {{token.text_subtle}}; }
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical { height: 0; background: none; border: none; }
QScrollBar:horizontal {
    background: transparent;
    height: 9px;
    margin: 2px;
    border: none;
}
QScrollBar::handle:horizontal {
    background: {{token.scrollbar}};
    border-radius: 4px;
    min-width: 34px;
}
QScrollBar::handle:horizontal:hover { background: {{token.text_subtle}}; }
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal { width: 0; background: none; border: none; }
