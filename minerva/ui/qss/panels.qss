/* Primary containing surfaces and panel headers. */
QFrame#surfacePanel {
    background: {{token.surface}};
    border: 1px solid {{token.border}};
    border-radius: {{token.radius_lg}};
}
QFrame#surfacePanel:hover { border-color: {{token.border_strong}}; }
QWidget#panelHeader { background: transparent; }
QLabel#panelHeaderTitle {
    color: {{token.text}};
    font-size: 14px;
    font-weight: 700;
}
QLabel#panelHeaderSubtitle {
    color: {{token.text_muted}};
    font-size: 11px;
}
QPushButton#panelHeaderButton {
    min-height: 30px;
    background: transparent;
    color: {{token.text_muted}};
    border: 1px solid transparent;
    border-radius: {{token.radius_sm}};
    padding: 2px 8px;
    font-size: 11px;
}
QPushButton#panelHeaderButton:hover {
    background: {{token.surface_hover}};
    color: {{token.text}};
    border-color: {{token.border}};
}
