/* Shared page and workspace layout surfaces. */
QWidget#pageHeader {
    min-height: 68px;
    background: transparent;
}
QFrame#pageHeaderDivider {
    background: {{token.border}};
    border: none;
    max-height: 1px;
}
QWidget#workspaceCanvas { background: transparent; }
QFrame#resultsToolbar {
    background: {{token.surface}};
    border: 1px solid {{token.border}};
    border-radius: {{token.radius_lg}};
}
QFrame#stickyFooter,
QFrame#settingsFooter {
    background: {{token.surface}};
    border: 1px solid {{token.border}};
    border-radius: {{token.radius_lg}};
}
