/* Loading / empty / error state treatments. */

/* Loading bar inside ContentState */
QProgressBar#contentStateLoadingBar {
    background: {{token.surface_raised}};
    border: none;
    border-radius: {{token.radius_sm}};
    text-align: center;
    font-size: 10px;
    min-height: 6px;
    max-height: 6px;
}
QProgressBar#contentStateLoadingBar::chunk {
    background: {{token.accent}};
    border-radius: {{token.radius_sm}};
}

/* Empty state already uses emptyStateTitle / emptyStateDescription from base.qss. */

/* Error state title and description (reuse emptyState tokens from base.qss). */
QLabel#emptyStateTitle {
    font-size: 18px;
    font-weight: 650;
    color: {{token.text}};
}
QLabel#emptyStateDescription {
    color: {{token.text_muted}};
    font-size: 12px;
}

/* ── Notification banners ─────────────────────────────────────────── */
QFrame#notificationBanner_info,
QFrame#notificationBanner_success,
QFrame#notificationBanner_warning,
QFrame#notificationBanner_error {
    border-radius: {{token.radius_md}};
}
QLabel#notificationTitle {
    color: {{token.text}};
    font-weight: 600;
    font-size: 12px;
}
QLabel#notificationBody {
    color: {{token.text_muted}};
    font-size: 11px;
}
QPushButton#notificationClose {
    background: transparent;
    border: none;
    border-radius: {{token.radius_sm}};
    padding: 2px;
}
QPushButton#notificationClose:hover { background: {{token.surface_raised}}; }
QPushButton#notificationAction {
    background: transparent;
    border: none;
    color: {{token.accent}};
    font-weight: 600;
    font-size: 11px;
    padding: 2px 8px;
}
QPushButton#notificationAction:hover { text-decoration: underline; }

/* ── Dialog titles ────────────────────────────────────────────────── */
QLabel#dialogTitle {
    font-family: "{{token.body_font}}";
    color: {{token.text}};
    font-size: 18px;
    font-weight: 600;
}
