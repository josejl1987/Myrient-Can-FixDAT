/* Loading, empty and notification states. */
QFrame#emptyStateCard {
    min-width: 430px;
    max-width: 540px;
    background: {{token.surface}};
    border: 1px solid {{token.border}};
    border-radius: {{token.radius_lg}};
}
QLabel#emptyStateIconWell {
    min-width: 72px;
    max-width: 72px;
    min-height: 72px;
    max-height: 72px;
    background: {{token.surface_raised}};
    border: 1px solid {{token.border}};
    border-radius: 36px;
}
QLabel#emptyStateTitle {
    color: {{token.text}};
    font-size: 19px;
    font-weight: 700;
}
QLabel#emptyStateDescription {
    color: {{token.text_muted}};
    font-size: 13px;
    line-height: 1.4;
}
QProgressBar#contentStateLoadingBar {
    min-height: 5px;
    max-height: 5px;
    background: {{token.surface_raised}};
    border: none;
    border-radius: 2px;
}
QProgressBar#contentStateLoadingBar::chunk {
    background: {{token.accent}};
    border-radius: 2px;
}
QFrame#notificationBanner_info,
QFrame#notificationBanner_success,
QFrame#notificationBanner_warning,
QFrame#notificationBanner_error {
    border-radius: {{token.radius_md}};
}
QLabel#notificationTitle {
    color: {{token.text}};
    font-weight: 700;
    font-size: 12px;
}
QLabel#notificationBody {
    color: {{token.text_muted}};
    font-size: 11px;
}
QPushButton#notificationClose {
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
    background: transparent;
    border: none;
    padding: 0;
}
QPushButton#notificationClose:hover { background: {{token.surface_hover}}; }
QPushButton#notificationAction {
    min-height: 28px;
    background: transparent;
    border: none;
    color: {{token.accent}};
    font-weight: 650;
    font-size: 11px;
    padding: 1px 8px;
}
QPushButton#notificationAction:hover { color: {{token.focus_ring}}; }
QLabel#dialogTitle {
    color: {{token.text}};
    font-size: 19px;
    font-weight: 700;
}
