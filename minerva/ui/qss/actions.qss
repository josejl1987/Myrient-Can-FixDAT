/* Role-based action groups. */
QPushButton#actionGroupPrimary {
    background: {{token.accent}};
    border-color: {{token.accent}};
    color: white;
    font-weight: 700;
}
QPushButton#actionGroupPrimary:hover {
    background: {{token.accent_hover}};
    border-color: {{token.accent_hover}};
}
QPushButton#actionGroupSecondary {
    text-align: left;
    background: transparent;
    border-color: transparent;
    color: {{token.text}};
    padding-left: 9px;
}
QPushButton#actionGroupSecondary:hover {
    background: {{token.surface_hover}};
    border-color: {{token.border}};
}
QPushButton#actionGroupDestructive {
    background: transparent;
    border-color: {{token.error_border}};
    color: {{token.error}};
}
QPushButton#actionGroupDestructive:hover { background: {{token.error_surface}}; }
